{
  "$schema": "https://raw.githubusercontent.com/microsoft/AL-Go-Actions/v9.2/.Modules/settings.schema.json",
  "country": "us",
  "appFolders": [],
  "testFolders": [],
  "bcptTestFolders": [],
  "versioningStrategy": 3,
  "versionBCPreserve": false,
  "versionBCMarker": 0,
  "DeployTo<EnvironmentName>": {
    "deploymentSchedule": "Immediate",
    "deployAfterRelease": false
  },
  "autoReleaseOnMerge": {
    "enabled": false,
    "branches": [ "main" ],
    "workflowType": "ReleaseWithDeploy",
    "versionIncrement": "+0.0.1"
  },
  "autoIncrementOnCICD": {
    "enabled": false,
    "branches": [ "OnPrem" ],
    "versionIncrement": "+0.0.1"
  }
}
